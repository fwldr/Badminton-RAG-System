# ============ badminton-rag 环境变量模板 ============
# 复制为 .env 并填写密钥（.env 已被 gitignore，不会提交）。
# 本地开发 / Docker Compose 共用此文件（compose 里 env_file: .env）。

# ---- 调试与日志 ----
DEBUG=false
LOG_LEVEL=INFO

# ---- 数据库后端（默认 mysql：业务库跑 MySQL；sqlite 仅离线测试自动使用，无需配置）----
DB_BACKEND=mysql
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=badminton
MYSQL_PASSWORD=change-me
MYSQL_DB=badminton                 # 库不存在时启动自动创建（账号需有 CREATE 权限）
MYSQL_CHARSET=utf8mb4

# ---- LLM + 文本 embedding（阿里云百炼 DashScope，OpenAI 兼容）----
# 生成与 embedding 共用同一个 key 与 base_url；embedding 端点为 {LLM_BASE_URL}/embeddings
LLM_API_KEY=sk-your-dashscope-key
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen3.8-flash

# ---- 精排（SiliconFlow BGE-Reranker；ask_use_rerank 关闭时链路不变）----
RERANK_API_KEY=sk-your-rerank-key
ASK_USE_RERANK=False

# ---- 管理接口鉴权（成本报表 / 审计 / 管理后台可用 X-Admin-Key 或管理员 JWT）----
ADMIN_API_KEY=change-me-admin-key

# ---- 双角色账户体系（Phase 7：用户 / 管理员）----
# 会话令牌签名密钥（生产必改，且要固定不变否则已发令牌会失效）
AUTH_TOKEN_SECRET=change-me-auth-secret
AUTH_TOKEN_TTL=604800                     # 令牌有效期（秒，默认 7 天）
# 启动时自动创建的种子管理员（首次启动幂等；留空则不创建）
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=change-me-admin-password

# ---- Langfuse 可观测（v4）。演示不依赖：LANGFUSE_ENABLED=false 时自动降级 NullTracer ----
# 开启需到 https://cloud.langfuse.com 创建项目拿 PK/SK；也可自托管（compose --profile selfhost）
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=pk-lf-your-public-key
LANGFUSE_SECRET_KEY=sk-lf-your-secret-key
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# ---- 文本 embedding（百炼 qwen3.7-text-embedding；key 与 base_url 复用上方 LLM_*）----
# 铁律：入库与查询必须同一 embedding 模型，改这一项后必须全量重索引（清空 data/chroma 重跑 pipeline）
# EMBEDDING_MODEL=qwen3.7-text-embedding

# ---- CORS（前端 dev 跨域用；生产同域 nginx 反代不需要，留空即可）----
# CORS_ORIGINS=http://localhost:5173

# ---- 文档/图片入库（Phase 6：PDF 与图片支持）----
# CLI 批量入库目录：python -m app.ingest.pipeline --dir data/raw_docs
# OCR_ENGINE=rapidocr              # 图片文字提取："rapidocr" | "none"
# ---- 多模态图片索引（SiliconFlow Qwen3-VL-Embedding API；图片/文本同空间 4096 维，按量计费）----
# VISION_EMBED_ENABLED=false       # 无文字图片（插画/实拍图）按图检索；缺 VISION_API_KEY 时回退用 RERANK_API_KEY
# VISION_API_KEY=sk-your-siliconflow-key   # 建议单独建 key；不设则复用 RERANK_API_KEY
# VISION_MODEL=Qwen/Qwen3-VL-Embedding-8B
# VISION_EMBED_DIM=0               # 0 = 用 API 默认（4096）；>0 时传 dimensions 截断
# UPLOAD_MAX_SIZE=20971520         # 管理端上传上限（默认 20MB）

# ---- LLM Wiki 模式（离线编译 Wiki + 在线导航检索；默认关闭，关闭时问答链路逐字不变）----
# 开启前需先编译：python -m scripts.build_wiki --skip-llm
# WIKI_MODE_ENABLED=false          # 总开关（管理端 RAG 调优中心可运行时覆盖）
# WIKI_MAX_STEPS=3                 # 导航循环步数上限（防 token/延迟失控）
# WIKI_DIR=data/wiki               # 派生条目页 + manifest.json + toc.json
